generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Architecture {
  id          String  @id @default(uuid())
  name        String
  description String
  version     Int
  parentId    String?
  nodes       Json
  edges       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Architecture?  @relation("ArchitectureVersions", fields: [parentId], references: [id])
  children Architecture[] @relation("ArchitectureVersions")

  evaluations EvaluationRun[]
}

model ComponentDefinition {
  id             String            @id @default(uuid())
  key            String            @unique
  displayName    String
  category       ComponentCategory
  vendor         Vendor
  supportedFlows DataFlowType[]
  scalingModel   ScalingModel
  failureMode    FailureMode
  assumptions    Json
  iconPath       String
  documentation  String?
  isManaged      Boolean
  isExperimental Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scenario {
  id          String       @id @default(uuid())
  type        ScenarioType
  name        String
  constraints Json

  evaluations EvaluationRun[]

  createdAt DateTime @default(now())
}

model EvaluationRun {
  id String @id @default(uuid())

  architectureId String
  architecture   Architecture @relation(fields: [architectureId], references: [id])

  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  verdict            Verdict
  saturationPointSec Int?
  maxThroughPutRps   Int?

  bottlenecks  Bottlenecks[]
  explanations Explanations[]

  createdAt DateTime @default(now())
}

model Bottlenecks {
  id              String        @id @default(uuid())
  evaluationRunId String
  evaluationRun   EvaluationRun @relation(fields: [evaluationRunId], references: [id])
  nodeId          String
  componentKey    String
  severity        Severity
  reason          String
  metrics         Json
  orderIndex      Int
  createdAt       DateTime      @default(now())
}

model Explanations {
  id              String        @id @default(uuid())
  evaluationRunId String
  evaluationRun   EvaluationRun @relation(fields: [evaluationRunId], references: [id])
  message         String
  severity        Severity
  relatedNodeId   String?
  relatedEdgeId   String?
  assumptionsUsed Json

  createdAt DateTime @default(now())
}

model ArchitectureComparison {
  id                     String   @id @default(uuid())
  baseArchitectureId     String
  modifiedArchitectureId String
  deltaSummary           Json
  createdAt              DateTime @default(now())
}

enum ComponentCategory {
  NETWORKING
  COMPUTE
  MESSAGING
  STREAMING
  CACHE
  DATABASE
  STORAGE
  SEARCH
  OBSERVABILITY
  SECURITY
  ORCHESTRATION
  SERVERLESS
  EDGE
}

enum Vendor {
  AWS
  GCP
  AZURE
  CLOUDFLARE
  CNCF
  APACHE
  REDIS
  MONGODB
  POSTGRESQL
  OSS
  CUSTOM
}

enum DataFlowType {
  SYNC
  ASYNC
  BATCH
  STREAM
}

enum ScalingModel {
  HORIZONTAL
  VERTICAL
  PARTITIONED
  SHARDED
  FIXED
}

enum FailureMode {
  FAIL_STOP
  DEGRADED
  BACKPRESSURE
  RETRY_STORM
}

enum Verdict {
  PASS
  RISKY
  FAIL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScenarioType {
  NORMAL
  FLASH_SALE
  BLACK_FRIDAY
  INCIDENT
  CUSTOM
}
