{
  "name": "atlaso-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/projects.spec.ts && tsx --test tests/architectures.spec.ts && tsx --test tests/canvas.spec.ts && tsx --test ../frontend/tests/architecture-store.spec.ts",
    "test:types": "tsc -p tsconfig.tests.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.3.27",
    "better-auth": "^1.3.27",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
